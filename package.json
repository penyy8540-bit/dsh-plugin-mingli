{
  "name": "dsh-plugin-mingli",
  "version": "0.1.0",
  "private": true,
  "description": "Mingli — Tianfu-style AI 命理推演 for DeepSeek Harness: 紫微斗数 / 子平八字 / 时家奇门, 命盘可视化, 人生轨迹.",
  "icon": "./icon.svg",
  "type": "module",
  "license": "MIT",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "locale",
    "cordis.patch.yml",
    "icon.svg",
    "README.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "shot": "node tools/shot.mjs",
    "serve": "node tools/serve.mjs",
    "parity": "node tools/parity.mjs",
    "verify": "node tools/verify.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-session"
      ]
    }
  },
  "dependencies": {
    "iztro": "2.6.3",
    "kinqimen": "0.4.0",
    "lunar-javascript": "1.7.7"
  },
  "devDependencies": {
    "esbuild": "0.25.12",
    "puppeteer-core": "^24.43.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
